  "changes": [
    {
      "topic": "TOP",
      "note": "Sion/Ornn are now deep Fearless options, not the default safe blinds. Jayce/Gnar/K'Sante/Rumble are the cleaner current starting points."
    },
    {
      "topic": "BOT",
      "note": "Yunara+Lulu, Kalista+Renata, Xayah+Rakan and Zeri+Yuumi are the clearest current duos."
    },
    {
      "topic": "CAITLYN",
      "note": "Keep Bard/Karma. Both showed up late in the playoffs, and they represent two different Caitlyn identities: roam/catch vs lane pressure."
    },
    {
      "topic": "CORKI",
      "note": "Keep Nami as the Clash default from the wider-season evidence. The only clear late-playoff Corki sample was Corki+Alistar, so do not replace Nami based on one game."
    },
    {
      "topic": "SIVIR",
      "note": "The current playoff version was repeatedly Sivir+Karma. Lulu stays the scaling/protect alternative."
    },
    {
      "topic": "MID-JGL",
      "note": "Azir+Skarner is downgraded. Skarner+Locke is the clean new repeated playoff pairing."
    },
    {
      "topic": "ZIGGS",
      "note": "Keep Nautilus/Leona as simple Clash defaults. The notable playoff variant was Ziggs+Pyke."
    }
